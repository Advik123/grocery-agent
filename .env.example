# .env.example
# Copy this file to .env and fill in the values.

# Flask server port (default: 5000)
PORT=5000

# Set to "development" for debug mode, "production" otherwise
FLASK_ENV=development

# Gemini API key — get yours free at aistudio.google.com (no credit card required)
GEMINI_API_KEY=your-gemini-api-key-here

# WhatsApp Cloud API credentials (from Meta Developer dashboard)
WA_PHONE_NUMBER_ID=your-phone-number-id-here
WA_ACCESS_TOKEN=your-access-token-here
WA_VERIFY_TOKEN=a-random-string-you-make-up
