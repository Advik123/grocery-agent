# .env.example
# Copy this file to .env and fill in the values.

# Flask server port (default: 5000)
PORT=5000

# Set to "development" for debug mode, "production" otherwise
FLASK_ENV=development

# Gemini API key — get yours free at aistudio.google.com (no credit card required)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional Gemini model override (default gemini-2.5-flash, thinking disabled).
# GEMINI_MODEL=gemini-2.5-flash

# Start Chromium when the app loads so the first request after boot is fast.
# Costs ~300-400 MB RAM for as long as the server runs (it is kept alive anyway
# after the first request).  Use with a single gunicorn worker.
BROWSER_WARMUP=1

# WhatsApp Cloud API credentials (from Meta Developer dashboard)
WA_PHONE_NUMBER_ID=your-phone-number-id-here
WA_ACCESS_TOKEN=your-access-token-here
WA_VERIFY_TOKEN=a-random-string-you-make-up

# Siri / Apple Shortcuts endpoint (POST /shortcut). Leave unset to disable (503).
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SHORTCUT_TOKEN=
# Optional: session id used for conversation memory (set to your WhatsApp
# number, e.g. 15551234567, to share history with that session). Default: shortcut
SHORTCUT_SENDER_ID=

# Token required by POST /add (X-Token header or Authorization: Bearer).
# Endpoint returns 503 if unset.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADD_TOKEN=replace-with-generated-token

# Meta App Secret used to verify X-Hub-Signature-256 on POST /whatsapp.
# Meta App Dashboard > App settings > Basic > App secret. Webhook returns 503 if unset.
WA_APP_SECRET=replace-with-meta-app-secret

# Token required by GET /status (X-Token header or Authorization: Bearer).
# Endpoint returns 503 if unset.
STATUS_TOKEN=replace-with-generated-token
